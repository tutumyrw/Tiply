<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tip Calculator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #20211d;
    --paper: #e4d6ae;
    --paper-dark: #d8c79a;
    --paper-inset: #cbb98a;
    --ink: #2b2620;
    --ink-soft: #6b5f4c;
    --red: #a63a2c;
    --red-dark: #832c21;
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    background: var(--bg);
    background-image:
      radial-gradient(ellipse at 50% -10%, rgba(255,255,255,0.05), transparent 60%),
      repeating-linear-gradient(45deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 1px, transparent 1px, transparent 10px);
    color: var(--ink);
    font-family: 'IBM Plex Mono', monospace;
    display: flex;
    justify-content: center;
    padding: 48px 16px 64px;
  }

  .ticket {
    width: 100%;
    max-width: 380px;
    background: var(--paper);
    position: relative;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6), 0 2px 0 rgba(255,255,255,0.15) inset;
    padding: 0 26px 30px;
  }

  /* torn perforated top edge */
  .ticket::before {
    content: "";
    display: block;
    height: 14px;
    margin: 0 -26px;
    background-image: radial-gradient(circle at 10px 0, var(--bg) 7px, transparent 7.5px);
    background-size: 20px 14px;
    background-repeat: repeat-x;
    background-position: top;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 18px 0 14px;
    border-bottom: 2px dashed var(--red);
  }

  header h1 {
    font-family: 'Roboto Slab', serif;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--ink);
  }

  header .ticket-no {
    font-size: 12px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  section {
    padding: 18px 0;
    border-bottom: 1px dashed var(--paper-inset);
  }

  section:last-of-type {
    border-bottom: none;
  }

  .label {
    font-family: 'Roboto Slab', serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-soft);
    margin: 0 0 10px;
  }

  .bill-input {
    display: flex;
    align-items: baseline;
    gap: 6px;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 6px;
  }

  .bill-input .currency {
    font-size: 22px;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .bill-input input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 30px;
    font-weight: 600;
    color: var(--ink);
    outline: none;
    width: 100%;
    min-width: 0;
  }

  .bill-input input::placeholder { color: var(--paper-inset); }

  .pct-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 10px;
  }

  .pct-btn {
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 600;
    font-size: 15px;
    padding: 10px 0;
    background: var(--paper-dark);
    border: 1px solid var(--paper-inset);
    border-radius: 999px;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, transform 0.1s;
  }

  .pct-btn:hover { transform: translateY(-1px); }

  .pct-btn.active {
    background: var(--red);
    border-color: var(--red-dark);
    color: var(--paper);
  }

  .custom-pct {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .custom-pct input {
    width: 64px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    background: var(--paper-dark);
    border: 1px solid var(--paper-inset);
    border-radius: 6px;
    padding: 6px 8px;
    outline: none;
  }

  .stepper {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stepper button {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--paper-inset);
    background: var(--paper-dark);
    color: var(--ink);
    font-size: 18px;
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
    cursor: pointer;
    line-height: 1;
  }

  .stepper button:active { transform: scale(0.95); }

  .stepper .count {
    font-size: 22px;
    font-weight: 600;
    min-width: 2ch;
    text-align: center;
  }

  .stepper .unit {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .totals-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 14px;
    color: var(--ink-soft);
    padding: 3px 0;
  }

  .totals-row span:last-child {
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 600;
    color: var(--ink);
  }

  .grand {
    margin-top: 12px;
    background: var(--red);
    color: var(--paper);
    padding: 14px 16px;
    border-radius: 4px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transform: rotate(-1deg);
    box-shadow: 0 6px 14px -6px rgba(0,0,0,0.5);
  }

  .grand .g-label {
    font-family: 'Roboto Slab', serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.03em;
  }

  .grand .g-value {
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 700;
    font-size: 26px;
  }

  footer {
    text-align: center;
    font-size: 11px;
    color: var(--ink-soft);
    padding-top: 16px;
    letter-spacing: 0.04em;
  }
</style>
</head>
<body>

<div class="ticket">
  <header>
    <h1>Guest Check</h1>
    <span class="ticket-no">No. 042</span>
  </header>

  <section>
    <p class="label">Bill Amount</p>
    <div class="bill-input">
      <span class="currency">$</span>
      <input type="number" inputmode="decimal" id="bill" placeholder="0.00" min="0" step="0.01">
    </div>
  </section>

  <section>
    <p class="label">Tip</p>
    <div class="pct-row" id="pctRow">
      <button class="pct-btn" data-pct="10">10%</button>
      <button class="pct-btn active" data-pct="15">15%</button>
      <button class="pct-btn" data-pct="20">20%</button>
      <button class="pct-btn" data-pct="25">25%</button>
    </div>
    <div class="custom-pct">
      <span>or custom:</span>
      <input type="number" id="customPct" placeholder="%" min="0" max="100">
    </div>
  </section>

  <section>
    <p class="label">Split Between</p>
    <div class="stepper">
      <button id="minus" aria-label="Decrease">–</button>
      <span class="count" id="count">1</span>
      <button id="plus" aria-label="Increase">+</button>
      <span class="unit">guest(s)</span>
    </div>
  </section>

  <section>
    <div class="totals-row"><span>Tip</span><span id="tipOut">$0.00</span></div>
    <div class="totals-row"><span>Total with tip</span><span id="totalOut">$0.00</span></div>
    <div class="grand">
      <span class="g-label">Per guest</span>
      <span class="g-value" id="perPersonOut">$0.00</span>
    </div>
  </section>

  <footer>THANK YOU, COME AGAIN</footer>
</div>

<script>
  const billInput = document.getElementById('bill');
  const customPct = document.getElementById('customPct');
  const pctButtons = document.querySelectorAll('.pct-btn');
  const minusBtn = document.getElementById('minus');
  const plusBtn = document.getElementById('plus');
  const countEl = document.getElementById('count');
  const tipOut = document.getElementById('tipOut');
  const totalOut = document.getElementById('totalOut');
  const perPersonOut = document.getElementById('perPersonOut');

  let selectedPct = 15;
  let guests = 1;

  function fmt(n) {
    return n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  }

  function recalc() {
    const bill = parseFloat(billInput.value) || 0;
    const pct = parseFloat(customPct.value) || selectedPct;
    const tip = bill * (pct / 100);
    const total = bill + tip;
    const perPerson = total / guests;

    tipOut.textContent = fmt(tip);
    totalOut.textContent = fmt(total);
    perPersonOut.textContent = fmt(perPerson);
  }

  pctButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      pctButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedPct = parseFloat(btn.dataset.pct);
      customPct.value = '';
      recalc();
    });
  });

  customPct.addEventListener('input', () => {
    if (customPct.value !== '') {
      pctButtons.forEach(b => b.classList.remove('active'));
    }
    recalc();
  });

  minusBtn.addEventListener('click', () => {
    if (guests > 1) guests--;
    countEl.textContent = guests;
    recalc();
  });

  plusBtn.addEventListener('click', () => {
    if (guests < 50) guests++;
    countEl.textContent = guests;
    recalc();
  });

  billInput.addEventListener('input', recalc);

  recalc();
</script>

</body>
</html>
